@page
@model SmartFarmSystem.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    .rpc-wrap {
        --field: #3F6B35;
        --field-deep: #23391E;
        --gold: #C98A2B;
        --gold-deep: #9C6A1E;
        --kraft: #C7B48C;
        --kraft-deep: #A8956B;
        --paper: #FFFDF8;
        --ink: #26301F;
        --ink-soft: #6B6252;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        background: radial-gradient(800px 400px at 15% 0%, rgba(255,255,255,0.15), transparent 60%), linear-gradient(160deg, var(--kraft) 0%, var(--kraft-deep) 100%);
    }

    .rpc-card {
        position: relative;
        width: 100%;
        max-width: 420px;
        background: var(--paper);
        border-radius: 0 0 10px 10px;
        box-shadow: 0 24px 50px -18px rgba(0,0,0,0.4);
        padding: 2.6rem 2.2rem 2.2rem;
        margin-top: 14px;
    }

        .rpc-card::before {
            content: "";
            position: absolute;
            top: -13px;
            left: 0;
            right: 0;
            height: 14px;
            background: linear-gradient(-45deg, var(--paper) 7px, transparent 0), linear-gradient(45deg, var(--paper) 7px, transparent 0);
            background-size: 14px 14px;
            background-position: left top;
            filter: drop-shadow(0 -2px 2px rgba(0,0,0,0.08));
        }

    .rpc-seal {
        width: 58px;
        height: 58px;
        margin: 0 auto 1.2rem;
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #E0A542, var(--gold) 55%, var(--gold-deep) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 6px rgba(0,0,0,0.25), inset 0 1px 2px rgba(255,255,255,0.4), inset 0 -3px 5px rgba(0,0,0,0.25);
    }

    .rpc-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--field-deep);
        text-align: center;
        display: block;
        margin-bottom: 0.6rem;
    }

    .rpc-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.75rem;
        text-align: center;
        margin: 0 0 0.6rem;
    }

    .rpc-sub {
        text-align: center;
        font-size: 0.92rem;
        color: var(--ink-soft);
        line-height: 1.6;
        max-width: 30ch;
        margin: 0 auto 1.6rem;
    }

    .rpc-divider {
        position: relative;
        border-top: 1px dashed #D6CBB0;
        margin: 0 -2.2rem 1.6rem;
    }

        .rpc-divider::before,
        .rpc-divider::after {
            content: "";
            position: absolute;
            top: -9px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--kraft-deep);
        }

        .rpc-divider::before {
            left: -9px;
        }

        .rpc-divider::after {
            right: -9px;
        }

    .rpc-field {
        margin-bottom: 1.1rem;
    }

        .rpc-field label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--ink-soft);
            margin-bottom: 0.35rem;
        }

        .rpc-field .form-control {
            border: 1px solid #D6CBB0;
            border-radius: 6px;
            padding: 0.65rem 0.8rem;
            font-size: 0.95rem;
            width: 100%;
            background: var(--paper);
        }

            .rpc-field .form-control:focus {
                outline: none;
                border-color: var(--field);
                box-shadow: 0 0 0 3px rgba(63, 107, 53, 0.15);
            }

    .text-danger {
        color: #B5502D !important;
        font-size: 0.82rem;
    }

    .rpc-cta {
        display: block;
        width: 100%;
        background: var(--field);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 0.8rem 1rem;
        font-size: 0.98rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease;
        margin-top: 0.4rem;
    }

        .rpc-cta:hover {
            background: var(--field-deep);
        }
</style>

<div class="rpc-wrap">
    <div class="rpc-card">
        <div class="rpc-seal">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FFF7E8" stroke-width="1.8">
                <path d="M4 20c4-8 6-11 8-14 2 3 4 6 8 14" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M12 6v14" stroke-linecap="round" />
            </svg>
        </div>

        <span class="rpc-eyebrow">Account setup</span>
        <h1 class="rpc-title">@ViewData["Title"]</h1>
        <p class="rpc-sub">Choose a password to finish setting up your account.</p>

        <div class="rpc-divider"></div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <input asp-for="Input.Email" type="hidden" />

            <div class="rpc-field">
                <label asp-for="Input.Password">New password</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="New password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="rpc-field">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="rpc-cta">Reset password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}