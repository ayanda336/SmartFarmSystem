@model SmartFarmSystem.Models.LeaveRequest

@{
    ViewData["Title"] = "Review Leave Request";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    .sf-leave-review {
        --field: #3F6B35;
        --field-deep: #2E4F27;
        --gold: #C98A2B;
        --gold-deep: #9C6A1E;
        --clay: #B5502D;
        --husk: #F4EFE2;
        --furrow: #E7DEC7;
        --paper: #FFFDF8;
        --ink: #2B2116;
        --ink-soft: #7C7565;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        max-width: 700px;
        margin: 0 auto;
        padding: 2rem;
        background: var(--paper);
        border: 1px solid var(--furrow);
        border-radius: 12px;
    }

    .sf-page-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--field-deep);
        display: block;
        margin-bottom: 0.4rem;
    }

    .sf-page-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: 0 0 1.5rem;
        color: var(--ink);
    }

    .sf-review-details {
        background: var(--husk);
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

        .sf-review-details dl {
            display: grid;
            grid-template-columns: 120px 1fr;
            gap: 0.5rem 0.8rem;
            margin: 0;
        }

        .sf-review-details dt {
            font-weight: 600;
            color: var(--ink-soft);
            font-size: 0.85rem;
        }

        .sf-review-details dd {
            margin: 0;
            font-size: 0.95rem;
        }

    .sf-reason-empty {
        color: var(--ink-soft);
        font-style: italic;
    }

    .sf-form-group {
        margin-bottom: 1.2rem;
    }

        .sf-form-group label {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--ink);
            display: block;
            margin-bottom: 0.3rem;
        }

        .sf-form-group .form-control {
            width: 100%;
            padding: 0.65rem 0.9rem;
            border: 1px solid var(--furrow);
            border-radius: 6px;
            font-size: 0.95rem;
            background: #FAF8F2;
        }

            .sf-form-group .form-control:focus {
                outline: none;
                border-color: var(--field);
                box-shadow: 0 0 0 3px rgba(63, 107, 53, 0.12);
            }

    .sf-review-actions {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .sf-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.55rem 1.2rem;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        line-height: 1.2;
        transition: background 0.15s ease;
    }

    .sf-btn-success {
        background: var(--field);
        color: #fff;
    }

        .sf-btn-success:hover {
            background: var(--field-deep);
            color: #fff;
        }

    .sf-btn-danger {
        background: var(--clay);
        color: #fff;
    }

        .sf-btn-danger:hover {
            background: #9C4224;
            color: #fff;
        }

    .sf-btn-outline {
        background: var(--paper);
        color: var(--ink);
        border-color: var(--furrow);
    }

        .sf-btn-outline:hover {
            background: var(--husk);
        }
</style>

<div class="sf-leave-review">
    <span class="sf-page-eyebrow">Review leave request</span>
    <h1 class="sf-page-title">Review Leave Request</h1>

    <div class="sf-review-details">
        <dl>
            <dt>Worker</dt>
            <dd>@Model.Worker?.FullName</dd>
            <dt>Leave Type</dt>
            <dd>@Model.LeaveType</dd>
            <dt>Start Date</dt>
            <dd>@Model.StartDate.ToShortDateString()</dd>
            <dt>End Date</dt>
            <dd>@Model.EndDate.ToShortDateString()</dd>
            <dt>Total Days</dt>
            <dd>@Model.TotalDays</dd>
            <dt>Reason</dt>
            <dd>
                @if (string.IsNullOrEmpty(Model.Reason))
                {
                    <span class="sf-reason-empty">No reason provided</span>
                }
                else
                {
                    @Model.Reason
                }
            </dd>
        </dl>
    </div>

    <form asp-action="Review" asp-route-id="@Model.Id" method="post">
        <div class="sf-form-group">
            <label for="reviewComment">Review Comment</label>
            <textarea id="reviewComment" name="reviewComment" class="form-control" rows="3" placeholder="Add your comments here..."></textarea>
        </div>

        <div class="sf-review-actions">
            <button type="submit" name="status" value="Approved" class="sf-btn sf-btn-success">
                <i class="fas fa-check"></i> Approve
            </button>
            <button type="submit" name="status" value="Rejected" class="sf-btn sf-btn-danger">
                <i class="fas fa-xmark"></i> Reject
            </button>
            <a asp-action="Index" class="sf-btn sf-btn-outline">Back</a>
        </div>
    </form>
</div>