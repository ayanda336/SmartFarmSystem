@model IEnumerable<SmartFarmSystem.Models.Message>

@{
    ViewData["Title"] = "Inbox";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    .sf-messages {
        --field: #3F6B35;
        --field-deep: #2E4F27;
        --husk: #F4EFE2;
        --furrow: #E7DEC7;
        --paper: #FFFDF8;
        --ink: #2B2116;
        --ink-soft: #7C7565;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
    }

    .sf-messages-header {
        margin-bottom: 1.5rem;
    }

    .sf-messages-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--field-deep);
        display: block;
        margin-bottom: 0.4rem;
    }

    .sf-messages-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: 0;
        color: var(--ink);
    }

    .sf-toolbar {
        display: flex;
        gap: 0.8rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .sf-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.55rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        line-height: 1.2;
        transition: background 0.15s ease;
    }

    .sf-btn-primary {
        background: var(--field);
        color: #fff;
    }

        .sf-btn-primary:hover {
            background: var(--field-deep);
            color: #fff;
        }

    .sf-btn-outline {
        background: var(--paper);
        color: var(--ink);
        border-color: var(--furrow);
    }

        .sf-btn-outline:hover {
            background: var(--husk);
        }

    .sf-btn-sm {
        font-size: 0.78rem;
        padding: 0.3rem 0.7rem;
    }

    .sf-btn-gold {
        background: #FCF0DC;
        color: #9C6A1E;
        border-color: #EFD9A8;
    }

        .sf-btn-gold:hover {
            background: #F7E4BE;
        }

    .sf-btn-red {
        background: #FDE8E5;
        color: #B5502D;
        border-color: #F5D0C8;
    }

        .sf-btn-red:hover {
            background: #FAD5CF;
        }

    .sf-panel {
        background: var(--paper);
        border: 1px solid var(--furrow);
        border-radius: 8px;
        overflow: auto;
    }

    .sf-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
        margin: 0;
    }

        .sf-table thead th {
            background: var(--husk);
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.66rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--field-deep);
            text-align: left;
            padding: 0.7rem 0.9rem;
            border-bottom: 1px solid var(--furrow);
        }

        .sf-table tbody td {
            padding: 0.7rem 0.9rem;
            border-bottom: 1px solid var(--furrow);
            vertical-align: middle;
        }

        .sf-table tbody tr:hover {
            background: #FBF8F0;
        }

        .sf-table tbody tr.unread {
            font-weight: 600;
            background: #F8FBF5;
        }

            .sf-table tbody tr.unread td:first-child::before {
                content: "●";
                color: var(--field);
                margin-right: 6px;
                font-size: 0.6rem;
            }

    .sf-empty-note {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--ink-soft);
    }

    .sf-message-subject {
        max-width: 250px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sf-actions {
        display: flex;
        gap: 0.3rem;
        flex-wrap: wrap;
    }

    .sf-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        font-size: 0.8rem;
        text-decoration: none;
        transition: background 0.15s ease;
        border: 1px solid transparent;
    }

    .sf-icon-view {
        background: var(--husk);
        color: var(--ink-soft);
        border-color: var(--furrow);
    }

        .sf-icon-view:hover {
            background: #E7DEC7;
            color: var(--ink);
        }

    .sf-icon-delete {
        background: #FDE8E5;
        color: #B5502D;
        border-color: #F5D0C8;
    }

        .sf-icon-delete:hover {
            background: #FAD5CF;
            color: #8C3F20;
        }
</style>

<div class="sf-messages">
    <div class="sf-messages-header">
        <span class="sf-messages-eyebrow">Messages</span>
        <h1 class="sf-messages-title">Inbox</h1>
    </div>

    <div class="sf-toolbar">
        <a asp-action="Compose" class="sf-btn sf-btn-primary">+ Compose</a>
        <a asp-action="Sent" class="sf-btn sf-btn-outline">Sent</a>
    </div>

    <div class="sf-panel">
        @if (!Model.Any())
        {
            <div class="sf-empty-note">
                <p style="font-size: 1.5rem; margin-bottom: 0.5rem;">📭</p>
                <p>Your inbox is empty.</p>
            </div>
        }
        else
        {
            <table class="sf-table">
                <thead>
                    <tr>
                        <th>From</th>
                        <th>Subject</th>
                        <th>Sent</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsRead ? "" : "unread")">
                            <td>@item.Sender?.Email</td>
                            <td class="sf-message-subject">@item.Subject</td>
                            <td>@item.SentAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span style="color: var(--ink-soft); font-size: 0.75rem;">Read</span>
                                }
                                else
                                {
                                    <span style="color: var(--field); font-size: 0.75rem; font-weight: 600;">Unread</span>
                                }
                            </td>
                            <td>
                                <div class="sf-actions">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="sf-icon-btn sf-icon-view" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete this message?')">
                                        <button type="submit" class="sf-icon-btn sf-icon-delete" title="Delete" style="border:none;">
                                            <i class="fas fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>