@model SmartFarmSystem.Models.Message

@{
    ViewData["Title"] = "Message Details";
    var isSender = Model.SenderId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    .sf-message-detail {
        --field: #3F6B35;
        --field-deep: #2E4F27;
        --husk: #F4EFE2;
        --furrow: #E7DEC7;
        --paper: #FFFDF8;
        --ink: #2B2116;
        --ink-soft: #7C7565;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
        max-width: 700px;
        margin: 0 auto;
    }

    .sf-page-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--field-deep);
        display: block;
        margin-bottom: 0.4rem;
    }

    .sf-page-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: 0 0 1.5rem;
        color: var(--ink);
    }

    .sf-message-card {
        background: var(--paper);
        border: 1px solid var(--furrow);
        border-radius: 12px;
        padding: 1.5rem 2rem;
        margin-bottom: 1.5rem;
    }

    .sf-message-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid var(--furrow);
        margin-bottom: 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

        .sf-message-meta .from-to {
            font-size: 0.9rem;
            color: var(--ink-soft);
        }

            .sf-message-meta .from-to strong {
                color: var(--ink);
            }

        .sf-message-meta .date {
            font-size: 0.8rem;
            color: var(--ink-soft);
        }

    .sf-message-subject {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.3rem;
        margin-bottom: 1rem;
    }

    .sf-message-body {
        font-size: 0.95rem;
        line-height: 1.7;
        white-space: pre-wrap;
        color: var(--ink);
    }

    .sf-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.55rem 1.2rem;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        line-height: 1.2;
        transition: background 0.15s ease;
    }

    .sf-btn-primary {
        background: var(--field);
        color: #fff;
    }

        .sf-btn-primary:hover {
            background: var(--field-deep);
            color: #fff;
        }

    .sf-btn-outline {
        background: var(--paper);
        color: var(--ink);
        border-color: var(--furrow);
    }

        .sf-btn-outline:hover {
            background: var(--husk);
        }

    .sf-btn-gold {
        background: #FCF0DC;
        color: #9C6A1E;
        border-color: #EFD9A8;
    }

        .sf-btn-gold:hover {
            background: #F7E4BE;
        }

    .sf-btn-red {
        background: #FDE8E5;
        color: #B5502D;
        border-color: #F5D0C8;
    }

        .sf-btn-red:hover {
            background: #FAD5CF;
        }

    .sf-actions {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
    }

    .sf-reply-section {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--furrow);
    }
</style>

<div class="sf-message-detail">
    <span class="sf-page-eyebrow">Message</span>
    <h1 class="sf-page-title">Message Details</h1>

    <div class="sf-message-card">
        <div class="sf-message-meta">
            <div class="from-to">
                <strong>From:</strong> @Model.Sender?.Email
                <span style="margin: 0 0.5rem;">•</span>
                <strong>To:</strong> @Model.Receiver?.Email
            </div>
            <div class="date">@Model.SentAt.ToString("dddd, MMMM dd, yyyy HH:mm")</div>
        </div>

        <div class="sf-message-subject">@Model.Subject</div>

        <div class="sf-message-body">@Model.Body</div>

        @if (Model.ParentMessage != null)
        {
            <div style="margin-top: 1.5rem; padding: 1rem; background: var(--husk); border-radius: 8px;">
                <div style="font-size: 0.75rem; color: var(--ink-soft); font-weight: 600; margin-bottom: 0.3rem;">
                    Original message from @Model.ParentMessage.Sender?.Email:
                </div>
                <div style="font-size: 0.85rem; color: var(--ink-soft);">
                    @Model.ParentMessage.Body
                </div>
            </div>
        }
    </div>

    <div class="sf-actions">
        @if (!isSender)
        {
            <a asp-action="Reply" asp-route-id="@Model.Id" class="sf-btn sf-btn-primary">Reply</a>
        }
        <a asp-action="Inbox" class="sf-btn sf-btn-outline">← Back to Inbox</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;"
              onsubmit="return confirm('Delete this message?')">
            <button type="submit" class="sf-btn sf-btn-red">Delete</button>
        </form>
    </div>
</div>