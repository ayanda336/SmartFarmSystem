@model IEnumerable<SmartFarmSystem.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    .sf-mytasks {
        --field: #3F6B35;
        --field-deep: #2E4F27;
        --gold: #C98A2B;
        --gold-deep: #9C6A1E;
        --clay: #B5502D;
        --husk: #F4EFE2;
        --furrow: #E7DEC7;
        --paper: #FFFDF8;
        --ink: #2B2116;
        --ink-soft: #7C7565;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
    }

    .sf-mytasks-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .sf-mytasks-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--field-deep);
        display: block;
        margin-bottom: 0.4rem;
    }

    .sf-mytasks-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: 0 0 0.4rem;
        color: var(--ink);
    }

    .sf-mytasks-sub {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin: 0;
    }

    .sf-count-pill {
        font-family: 'IBM Plex Mono', monospace;
        background: var(--husk);
        border: 1px solid var(--furrow);
        border-radius: 999px;
        padding: 0.4rem 1rem;
        font-size: 0.85rem;
        color: var(--field-deep);
        white-space: nowrap;
    }

    .sf-alert-warning {
        background: #FCF0DC;
        color: var(--gold-deep);
        border: 1px solid #EFD9A8;
        border-radius: 6px;
        padding: 0.85rem 1rem;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sf-empty-panel {
        background: var(--paper);
        border: 1px solid var(--furrow);
        border-radius: 8px;
        text-align: center;
        padding: 3rem 1.5rem;
    }

    .sf-empty-icon {
        color: var(--field);
        margin-bottom: 0.8rem;
    }

    .sf-empty-panel h2 {
        font-family: 'Fraunces', serif;
        font-weight: 500;
        font-size: 1.2rem;
        margin: 0 0 0.4rem;
        color: var(--ink);
    }

    .sf-empty-panel p {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin: 0;
    }

    /* Task cards */
    .sf-task-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.2rem;
    }

    .sf-task-card {
        background: var(--paper);
        border: 1px solid var(--furrow);
        border-top: 3px solid var(--gold);
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

        .sf-task-card.status-completed {
            border-top-color: var(--field);
        }

        .sf-task-card.status-progress {
            border-top-color: #2E4F6B;
        }

    .sf-task-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.6rem;
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid var(--furrow);
        background: var(--husk);
    }

    .sf-task-card-title {
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--ink);
    }

    .sf-status-badge {
        font-size: 0.68rem;
        font-weight: 600;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .sf-status-completed {
        background: #E7F1E3;
        color: var(--field-deep);
    }

    .sf-status-progress {
        background: #E7EEF6;
        color: #2E4F6B;
    }

    .sf-status-other {
        background: #FCF0DC;
        color: var(--gold-deep);
    }

    .sf-task-card-body {
        padding: 1.1rem;
        flex: 1;
    }

    .sf-task-desc {
        font-size: 0.88rem;
        color: var(--ink-soft);
        margin: 0 0 1rem;
        line-height: 1.5;
    }

    .sf-task-fieldset {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px dashed var(--furrow);
        padding-top: 0.8rem;
    }

    .sf-task-fieldrow {
        display: flex;
        justify-content: space-between;
        gap: 0.6rem;
        padding: 0.35rem 0;
        font-size: 0.85rem;
    }

        .sf-task-fieldrow dt {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: var(--ink-soft);
            margin: 0;
        }

        .sf-task-fieldrow dd {
            margin: 0;
            color: var(--ink);
            text-align: right;
        }

    .sf-overdue {
        color: var(--clay);
        font-weight: 700;
    }

    .sf-task-card-footer {
        padding: 0.9rem 1.1rem;
        border-top: 1px solid var(--furrow);
    }

    .sf-btn-complete {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        width: 100%;
        background: var(--field);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 0.6rem 1rem;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease;
    }

        .sf-btn-complete:hover {
            background: var(--field-deep);
        }

    .sf-completed-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        color: var(--field-deep);
        font-size: 0.88rem;
        font-weight: 600;
    }
</style>

<div class="sf-mytasks">
    <div class="sf-mytasks-header">
        <div>
            <span class="sf-mytasks-eyebrow">Worker dashboard</span>
            <h1 class="sf-mytasks-title">My Tasks</h1>
            <p class="sf-mytasks-sub">Welcome, <strong>@ViewBag.WorkerName</strong> (Employee ID: @ViewBag.EmployeeCode)</p>
        </div>
        <span class="sf-count-pill">@Model.Count() tasks</span>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="sf-alert-warning">
            <i class="fas fa-triangle-exclamation"></i> @ViewBag.Message
        </div>
    }

    @if (!Model.Any())
    {
        <div class="sf-empty-panel">
            <div class="sf-empty-icon"><i class="fas fa-clipboard-check fa-2x"></i></div>
            <h2>No tasks assigned yet</h2>
            <p>You don't have any tasks assigned to you at the moment. Check back later!</p>
        </div>
    }
    else
    {
        <div class="sf-task-grid">
            @foreach (var task in Model)
            {
                var cardStatusClass = task.Status == "Completed" ? "status-completed"
                : task.Status == "In Progress" ? "status-progress"
                : "";
                var badgeClass = task.Status == "Completed" ? "sf-status-completed"
                : task.Status == "In Progress" ? "sf-status-progress"
                : "sf-status-other";

                <div class="sf-task-card @cardStatusClass">
                    <div class="sf-task-card-header">
                        <span class="sf-task-card-title">@task.Title</span>
                        <span class="sf-status-badge @badgeClass">@task.Status</span>
                    </div>
                    <div class="sf-task-card-body">
                        <p class="sf-task-desc">@(task.Description ?? "No description")</p>
                        <dl class="sf-task-fieldset">
                            <div class="sf-task-fieldrow">
                                <dt>Project</dt>
                                <dd>@task.Project?.Name</dd>
                            </div>
                            <div class="sf-task-fieldrow">
                                <dt>Assigned</dt>
                                <dd>@task.AssignedDate.ToShortDateString()</dd>
                            </div>
                            @if (task.DueDate.HasValue)
                            {
                                <div class="sf-task-fieldrow">
                                    <dt>Due date</dt>
                                    <dd>
                                        @if (task.DueDate.Value < DateTime.Now && task.Status != "Completed")
                                        {
                                            <span class="sf-overdue">@task.DueDate.Value.ToShortDateString() &middot; overdue</span>
                                        }
                                        else
                                        {
                                            @task.DueDate.Value.ToShortDateString()
                                        }
                                    </dd>
                                </div>
                            }
                            @if (task.Resource != null)
                            {
                                <div class="sf-task-fieldrow">
                                    <dt>Resource</dt>
                                    <dd>@task.Resource.Name (@task.QuantityNeeded @task.Resource.Unit)</dd>
                                </div>
                            }
                        </dl>
                    </div>
                    <div class="sf-task-card-footer">
                        @if (task.Status != "Completed")
                        {
                            <form asp-action="MarkComplete" asp-route-id="@task.Id" method="post" onsubmit="return confirm('Mark this task as complete?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="sf-btn-complete">
                                    <i class="fas fa-circle-check"></i> Mark Complete
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="sf-completed-note">
                                <i class="fas fa-circle-check"></i> Completed
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>