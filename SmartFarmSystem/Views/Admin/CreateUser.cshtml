@{
    ViewData["Title"] = "Create User";
}
@{
    var allRoles = ViewBag.AllRoles as List<Microsoft.AspNetCore.Identity.IdentityRole>;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">

<style>
    .sf-admin {
        --field: #3F6B35;
        --field-deep: #2E4F27;
        --gold: #C98A2B;
        --gold-deep: #9C6A1E;
        --clay: #B5502D;
        --husk: #F4EFE2;
        --furrow: #E7DEC7;
        --paper: #FFFDF8;
        --ink: #2B2116;
        --ink-soft: #7C7565;
        font-family: 'Inter', sans-serif;
        color: var(--ink);
    }

    .sf-admin-header {
        margin-bottom: 0.4rem;
    }

    .sf-admin-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--field-deep);
        display: block;
        margin-bottom: 0.4rem;
    }

    .sf-admin-title {
        font-family: 'Fraunces', serif;
        font-weight: 600;
        font-size: 1.7rem;
        margin: 0 0 0.4rem;
        color: var(--ink);
    }

    .sf-admin-sub {
        color: var(--ink-soft);
        font-size: 0.9rem;
        margin: 0 0 1.5rem;
        max-width: 55ch;
    }

    .sf-alert-danger {
        background: #F6E4DC;
        color: var(--clay);
        border: 1px solid #EAC4B4;
        border-radius: 6px;
        padding: 0.85rem 1rem;
        font-size: 0.88rem;
        margin-bottom: 1.5rem;
    }

        .sf-alert-danger ul {
            margin: 0;
            padding-left: 1.1rem;
        }

    .sf-formcard {
        background: var(--paper);
        border: 1px solid var(--furrow);
        border-radius: 8px;
        padding: 1.75rem;
        max-width: 480px;
    }

    .sf-field {
        margin-bottom: 1.2rem;
    }

        .sf-field label {
            display: block;
            font-size: 0.82rem;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 0.4rem;
        }

        .sf-field .form-control,
        .sf-field .form-select {
            border: 1px solid var(--furrow);
            border-radius: 6px;
            padding: 0.6rem 0.8rem;
            font-size: 0.92rem;
            width: 100%;
            background: var(--paper);
            color: var(--ink);
        }

            .sf-field .form-control:focus,
            .sf-field .form-select:focus {
                outline: none;
                border-color: var(--field);
                box-shadow: 0 0 0 3px rgba(63, 107, 53, 0.12);
            }

    .sf-form-actions {
        display: flex;
        gap: 0.6rem;
        margin-top: 1.5rem;
    }

    .sf-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.88rem;
        font-weight: 600;
        padding: 0.6rem 1.1rem;
        border-radius: 6px;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        line-height: 1.2;
    }

    .sf-btn-primary {
        background: var(--field);
        color: #fff;
    }

        .sf-btn-primary:hover {
            background: var(--field-deep);
            color: #fff;
        }

    .sf-btn-outline {
        background: var(--paper);
        color: var(--ink);
        border-color: var(--furrow);
    }

        .sf-btn-outline:hover {
            background: var(--husk);
            color: var(--ink);
        }
</style>

<div class="sf-admin">
    <div class="sf-admin-header">
        <span class="sf-admin-eyebrow">Admin &middot; User management</span>
        <h1 class="sf-admin-title">Create user</h1>
    </div>
    <p class="sf-admin-sub">The new user will set their own password via a one-time setup link — you won't need to share a password with them.</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="sf-alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="sf-formcard">
        <form asp-action="CreateUser" method="post">
            <div class="sf-field">
                <label>Email</label>
                <input type="email" name="email" class="form-control" required />
            </div>
            <div class="sf-field">
                <label>Role</label>
                <select name="role" class="form-select">
                    <option value="">-- No Role --</option>
                    @if (allRoles != null)
                    {
                        @foreach (var role in allRoles)
                        {
                            <option value="@role.Name">@role.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="sf-form-actions">
                <button type="submit" class="sf-btn sf-btn-primary">Create User</button>
                <a asp-action="Index" class="sf-btn sf-btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>